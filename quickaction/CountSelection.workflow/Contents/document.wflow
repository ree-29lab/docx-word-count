				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>SUPPORT="$HOME/Library/Application Support/DocxWordCount"
LOG="$HOME/Library/Logs/DocxWordCount.log"
if [ ! -x "$SUPPORT/wordcount" ]; then
  /usr/bin/osascript -e 'display dialog "统计选中字数：找不到已安装的程序，请再运行一次 install.sh。" buttons {"好"} default button 1'
  exit 1
fi
payload="$(cat)"
printf '[%s] 服务被调用，收到 %s 个字符\n' "$(date '+%H:%M:%S')" "${#payload}" &gt;&gt; "$LOG"
printf '%s' "$payload" | "$SUPPORT/wordcount" --stdin --dialog</string>
					<key>CheckedForUserDefaultShell</key>
					<true/>
					<key>inputMethod</key>
					<integer>0</integer>
					<key>shell</key>
					<string>/bin/bash</string>
					<key>source</key>
					<string></string>
				</dict>
